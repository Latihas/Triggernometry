<Project Sdk="Dalamud.NET.Sdk/14.0.2">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Triggernometry</RootNamespace>
    <AssemblyName>Triggernometry</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>2.99.99.99</Version>
    <AssemblyVersion>2.99.99.99</AssemblyVersion>
    <FileVersion>2.99.99.99</FileVersion>
    <Nullable>enable</Nullable>
    <Use_DalamudPackager>false</Use_DalamudPackager>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../NotACT/NotACT.csproj"/>
    <ProjectReference Include="../../../OverlayPlugin.Core/OverlayPlugin.Core.csproj"/>
    <ProjectReference Include="../../../ChineseConverter/ChineseConverter.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="*"/>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="*"/>
    <PackageReference Include="Microsoft.CodeAnalysis.Scripting" Version="5.3.0" />
    <PackageReference Include="SharpDX.Direct2D1" Version="*"/>
    <PackageReference Include="SharpDX.Direct3D11" Version="*"/>
    <PackageReference Include="System.Management" Version="10.0.7" />
    <PackageReference Include="System.Speech" Version="*"/>
    <PackageReference Include="WebSocketSharp-netstandard" Version="*"/>
    <Reference Include="FFXIV_ACT_Plugin">
      <HintPath>../../../external_dependencies/FFXIV_ACT_Plugin.dll</HintPath>
    </Reference>
  </ItemGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == ''">
    <DalamudLibPath>$(appdata)/XIVLauncherCN/addon/Hooks/dev</DalamudLibPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(DalamudLibPath)</AssemblySearchPaths>
  </PropertyGroup>
</Project>
